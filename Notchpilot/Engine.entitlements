<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Hardened-runtime entitlements for the bundled Bun engine (Contents/Helpers/notchbee-engine).
  Nothing else is granted: no sandbox exceptions, network, Apple Events or camera/microphone.
  allow-jit: Bun runs JavaScript on JavaScriptCore, which maps executable JIT memory.
  disable-library-validation: Bun extracts its embedded native modules (SQLite, PTY) at launch and loads them
    with dlopen. They are not signed with the app's team, so library validation would reject them. Verified:
    with allow-jit alone the engine exits before publishing its runtime record.
-->
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
