-// series per group per server, however many agents and processes come and go.
-const PROVIDER_GROUPS: ReadonlyArray<readonly [RegExp, string]> = [
-  [/codex/, "codex"],
-  [/claude/, "claude"],
-  [/cursor/, "cursor"],
-  [/opencode/, "opencode"],
-  [/grok/, "grok"],
-  [/antigravity|gemini/, "antigravity"],
