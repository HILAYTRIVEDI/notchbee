-    Config.option,
-    Config.map((option): Setting<A> => {
-      const raw = blankAsUnset(Option.getOrUndefined(option));
-      if (raw === undefined) {
-        return { value: undefined };
-      }
-      return Option.match(parse(raw), {
-        onNone: () => ({ value: undefined, warning }),
-        onSome: (value) => ({ value }),
-      });
-    }),
-  );
