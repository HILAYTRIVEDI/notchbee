-      },
-      preserveEmptyStrings: true,
-    }),
-    { asPrimary: true },
-  );
-
-export const none: OtelEnvironment = {
-  disabled: false,
-  warnings: [],
-  resourceAttributes: {},
-  traces: OtelSignal.Unset(),
-  metrics: OtelSignal.Unset(),
-  logs: OtelSignal.Unset(),
-};
